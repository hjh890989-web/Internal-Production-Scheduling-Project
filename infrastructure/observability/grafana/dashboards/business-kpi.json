{
  "title": "Scheduling — Business KPI (EP-47, NS-S01~S09)",
  "tags": ["scheduling", "sprint6", "ep-47", "kpi"],
  "timezone": "Asia/Seoul",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "NS-S04 — Kakao 도달률 (목표 ≥ 95%)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(scheduling_kakao_delivery_success_total) / clamp_min(sum(scheduling_kakao_delivery_total), 1) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "yellow","value": 90 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "NS-S09 — 신규 라인 사용률 (목표 ≥ 90%)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "scheduling_kpi_new_line_usage_ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "yellow","value": 85 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "BR-V07 일중 락 위반 (목표 = 0)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "increase(scheduling_kpi_intraday_lock_violations_total[1d])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "NS-S07 — D-1 압출 deadline 준수율 (목표 ≥ 98%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "scheduling_kpi_d_minus_1_compliance_ratio",
          "legendFormat": "D-1 준수율",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 5,
      "title": "K-V02 — 가류기 가동률 (목표 ≥ 85%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "scheduling_kpi_vc_machine_utilization_ratio",
          "legendFormat": "{{machine_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    }
  ]
}
