# =============================================================================
# infrastructure/.env.stg.example — STG 환경 변수 템플릿
# =============================================================================
# 실제 .env.stg 는 git ignore (rule: infrastructure/.env.*).
# 사내 vault 또는 secret manager 에서 주입.
# =============================================================================

# ---------- PostgreSQL (STG DB 분리) ----------
POSTGRES_DB=scheduling_stg
POSTGRES_USER=app_user
POSTGRES_PASSWORD=<vault — STG 전용, PROD 와 별도>

# ---------- Redis ----------
REDIS_PASSWORD=<vault>

# ---------- Backend ----------
HARBOR_REGISTRY=harbor.internal/scheduling
TAG=latest                              # 또는 git-sha (예: develop-3ab2f1c)
SPRING_PROFILES_ACTIVE=stg,with-infra
JAVA_OPTS=-Xms512m -Xmx2g

# ---------- Keycloak (STG 전용 realm 권장 또는 PROD realm 공용) ----------
KEYCLOAK_HOST=stg.scheduling.internal
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<vault>
KEYCLOAK_DB_PASSWORD=<vault>

# Sprint 6 EP-42 — OIDC issuer + JWKS (Spring Boot OAuth2 resource server 자동 활성)
# 미설정 시 SecurityConfig fallback (permitAll) — 베타 진입 전 반드시 설정
KEYCLOAK_ISSUER_URI=https://stg.scheduling.internal/realms/scheduling
KEYCLOAK_JWKS_URI=https://stg.scheduling.internal/realms/scheduling/protocol/openid-connect/certs

# ---------- Kakao BizMessage (Sprint 5 EP-16 + Sprint 6 EP-41 Resilience4j @Retry) ----------
KAKAO_ENABLED=true
KAKAO_WEBHOOK_URL=<vault — Kakao Workplace Bot webhook>
KAKAO_BOT_TOKEN=<vault — BotToken>

# ---------- Frontend (AG Grid Enterprise 라이센스 + 빌드 시 주입) ----------
VITE_AG_GRID_LICENSE_KEY=<vault — 사내 발급 Enterprise key>

# ---------- Grafana 10.4 (TK-31-1-3) ----------
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=<vault>

# ---------- AlertManager (TK-31-2-3) ----------
SLACK_WEBHOOK_URL=<vault — STG 알림 채널 webhook>

# ---------- NGINX ----------
SERVER_NAME=stg.scheduling.internal
