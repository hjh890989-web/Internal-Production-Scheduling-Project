{
  "title": "Scheduling — Overview (EP-44)",
  "tags": ["scheduling", "sprint6", "ep-44"],
  "timezone": "Asia/Seoul",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "API p95 latency (EX matrix / VC slots)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/schedule/.*\"}[5m])) by (uri, le))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red",    "value": 0.8 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Resilience4j — Kakao Retry / CircuitBreaker (EP-41)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(resilience4j_retry_calls_total{name=\"kakaotalk\"}[5m])",
          "legendFormat": "retry / {{kind}}",
          "refId": "A"
        },
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"kakaotalk\"}",
          "legendFormat": "circuit / {{state}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "VC confirm / EX cascade replan throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{uri=~\"/api/v1/schedule/.*/confirm.*\"}[5m])",
          "legendFormat": "confirm / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "audit_log INSERT rate (BR-X02)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(scheduling_audit_insert_total[5m])",
          "legendFormat": "{{table}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "HikariCP — active / idle connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{pool=\"HikariPool-1\"}",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{pool=\"HikariPool-1\"}",
          "legendFormat": "idle",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM heap — used / max",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "used / {{id}}",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "max / {{id}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    }
  ]
}
